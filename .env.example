# Serveur HTTP (port imposé par l'environnement de prévisualisation)
PORT=3000
NODE_ENV=development

# URL publique de l'application (injectée automatiquement en production)
APP_URL="MY_APP_URL"

# Limites et paramètres du moteur de résolution (appliqués côté serveur)
SOLVER_MAX_VARIABLES=100
SOLVER_MAX_CONSTRAINTS=200
SOLVER_TIMEOUT_MS=120000
SOLVER_TOLERANCE=1e-9

# Variables Cloud SQL PostgreSQL (injectées par la plateforme, ne jamais mettre de secret réel ici)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
